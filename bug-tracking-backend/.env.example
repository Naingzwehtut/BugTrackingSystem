# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub.

# --- Supabase ---
# Project URL: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Use the SERVICE_ROLE key here, NOT the anon/public key.
# Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
# This key bypasses Row Level Security, which is required since this Flask
# backend enforces all authorization itself. Keep it secret - it must only
# ever live in backend environment variables, never in frontend code.
SUPABASE_KEY=your-service-role-key-here

# --- JWT ---
# Any long random string. You can generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_HOURS=24

# --- CORS ---
# Comma-separated list of allowed frontend origins, or "*" for any origin
# (fine for a university demo, but tighten this for real deployments).
CORS_ORIGINS=*

# --- Platform owners ---
# Comma-separated emails of you and your team. Registering with one of these
# emails creates an OWNER account: owners approve "Request admin access"
# and receive those request emails.
OWNER_EMAILS=you@example.com,teammate@example.com

# --- Email (optional) ---
# Leave SMTP_HOST empty and emails are only written to the server log.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address,
#        SMTP_PASSWORD=a 16-character App Password (Google Account -> Security ->
#        2-Step Verification -> App passwords). Your normal password won't work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_SSL=false
EMAIL_FROM=
# Public URL of the frontend, used for the buttons inside emails.
APP_URL=http://localhost:5173

# --- Flask ---
# "development" enables Flask's debug mode locally. Render should use
# "production" (or simply not set this variable).
FLASK_ENV=development
