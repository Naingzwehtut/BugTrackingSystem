# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub.

# --- Supabase ---
# Project URL: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://mjzvwfixyhoomtdahgqf.supabase.co

# Use the SERVICE_ROLE key here, NOT the anon/public key.
# Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role
# This key bypasses Row Level Security, which is required since this Flask
# backend enforces all authorization itself. Keep it secret - it must only
# ever live in backend environment variables, never in frontend code.
# SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1qenZ3Zml4eWhvb210ZGFoZ3FmIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODc0MjAyOCwiZXhwIjoyMTA0MzE4MDI4fQ._u0BdFaS1ZWloxnIkibaWgULKc3G-486g_PSacqoMcc
